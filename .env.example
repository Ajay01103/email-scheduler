# Local development values only. Replace these before exposing any service.
POSTGRES_PASSWORD=local-postgres-password
DATABASE_URL=postgresql://emails:local-postgres-password@localhost:5432/emails
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails
PORT=3000
API_KEY=local-development-api-key-change-me-32
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=local-dashboard-password
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_DOMAIN=example.test
WORKER_CONCURRENCY=8
MIN_SEND_INTERVAL_MS=1000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
OUTBOX_POLL_MS=1000
RECONCILE_INTERVAL_MS=30000
SEND_LEASE_MS=120000
LOG_LEVEL=info
